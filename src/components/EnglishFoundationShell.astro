---
import { getRoute } from '../utils/routes'

interface Props {
  active: 'overview' | 'sql' | 'tools'
}

const { active } = Astro.props
const navigation = [
  { id: 'overview', label: 'Overview', path: '/en/' },
  { id: 'sql', label: 'SQL', path: '/en/sql/' },
  { id: 'tools', label: 'Tools', path: '/en/tools/' },
] as const
---

<div class="english-foundation">
  <header class="english-foundation__header">
    <a
      class="english-foundation__brand"
      href={getRoute('/en/')}
      aria-label="sql.sb English resources"
    >
      <strong>sql.sb</strong>
      <span>English resources</span>
    </a>
    <nav class="english-foundation__nav" aria-label="English content">
      {navigation.map((item) => (
        <a href={getRoute(item.path)} aria-current={active === item.id ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
  </header>

  <slot />

  <footer class="english-foundation__footer">
    <span>sql.sb · English SEO Foundation</span>
    <a href={getRoute('/')}>Chinese home</a>
  </footer>
</div>
