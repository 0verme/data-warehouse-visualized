---
import { getRoute } from '../utils/routes'
import { type EnglishSectionId, getEnglishRoute } from '../utils/english-routes'

interface Props {
  active: EnglishSectionId
}

const { active } = Astro.props
const navigation = [
  { id: 'overview', label: 'Overview' },
  { id: 'sql', label: 'SQL' },
  { id: 'warehouse', label: 'Data warehouse' },
  { id: 'tools', label: 'Tools' },
] as const satisfies readonly { id: EnglishSectionId; label: string }[]
---

<div class="english-foundation">
  <header class="english-foundation__header">
    <a
      class="english-foundation__brand"
      href={getEnglishRoute('overview')}
      aria-label="sql.sb English resources"
    >
      <strong>sql.sb</strong>
      <span>English resources</span>
    </a>
    <nav class="english-foundation__nav" aria-label="English content">
      {navigation.map((item) => (
        <a href={getEnglishRoute(item.id)} aria-current={active === item.id ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
  </header>

  <slot />

  <footer class="english-foundation__footer">
    <span>sql.sb · English resources</span>
    <a href={getRoute('/')}>Chinese home</a>
  </footer>
</div>
