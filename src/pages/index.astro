---
import BaseLayout from '../layouts/BaseLayout.astro'
import { chapters, lessons } from '../data/course'

const actualDemoCount = lessons.filter((lesson) => lesson.demo !== 'coming-soon').length
const baseUrl = import.meta.env.BASE_URL
---

<BaseLayout
  title="数据仓库图解｜从一张表开始，看懂数据仓库"
  description="面向中文学习者的交互式数据仓库可视化教材。通过图解、动画与模拟器，理解数据为什么这样流动、系统为什么这样设计。"
>
  <div class="site-shell">
    <header class="site-header">
      <a class="brand" href={baseUrl} aria-label="数据仓库图解首页">
        <span class="brand__mark" aria-hidden="true">
          <i />
          <i />
          <i />
        </span>
        <span class="brand__text">
          <strong>数据仓库图解</strong>
          <small>交互式教材</small>
        </span>
      </a>
      <nav class="site-header__nav" aria-label="主导航">
        <a href="#course-map">课程路线</a>
        <a href="#principles">学习方式</a>
        <a class="button button--nav" href={`${baseUrl}learn/`}>
          开始学习 <span aria-hidden="true">→</span>
        </a>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__copy">
          <div class="eyebrow-row">
            <span class="eyebrow-pill">
              <span class="status-dot" /> MVP · 正在生长
            </span>
            <span class="eyebrow-muted">面向中文学习者</span>
          </div>
          <h1 id="hero-title">
            从一张表开始，<em>看懂</em>数据仓库。
          </h1>
          <p class="hero__lead">
            一套把抽象概念变成数据流、状态变化和可操作实验的交互式教材。不是背概念，而是看懂数据如何流动。
          </p>
          <div class="hero__actions">
            <a class="button button--primary" href={`${baseUrl}learn/`}>
              开始学习 <span aria-hidden="true">→</span>
            </a>
            <a class="text-link" href="#course-map">
              先看看课程路线 <span aria-hidden="true">↓</span>
            </a>
          </div>
          <div class="hero__meta">
            <span>
              <strong>{lessons.length}</strong> 节课程骨架
            </span>
            <span class="hero__meta-separator" aria-hidden="true" />
            <span>
              <strong>{actualDemoCount}</strong> 个可操作 Demo
            </span>
            <span class="hero__meta-separator" aria-hidden="true" />
            <span>无需登录</span>
          </div>
        </div>

        <div class="hero__visual" aria-label="从业务系统到分析结果的数据流预览">
          <div class="hero-card hero-card--source">
            <span class="hero-card__label">业务系统</span>
            <strong>订单 · 用户 · 商品</strong>
            <small>记录正在发生的业务</small>
          </div>
          <div class="hero-flow-line hero-flow-line--one">
            <span>接入</span>
            <i />
          </div>
          <div class="hero-card hero-card--warehouse">
            <span class="hero-card__label">数据仓库</span>
            <strong>统一 · 加工 · 复用</strong>
            <small>让数据可以被看懂</small>
          </div>
          <div class="hero-flow-line hero-flow-line--two">
            <span>服务</span>
            <i />
          </div>
          <div class="hero-card hero-card--result">
            <span class="hero-card__label">分析结果</span>
            <strong>报表 · 指标 · 决策</strong>
            <small>从数据回到问题</small>
          </div>
          <span class="hero-visual__caption">数据不是静态名词，而是一条有方向的路径。</span>
        </div>
      </section>

      <section class="principles-section" id="principles" aria-labelledby="principles-title">
        <div class="section-heading section-heading--wide">
          <span class="eyebrow">为什么是交互式</span>
          <h2 id="principles-title">把“是什么”，变成“看见它怎么工作”。</h2>
        </div>
        <div class="principles-grid">
          <article class="principle-card">
            <span class="principle-card__index">01</span>
            <div class="principle-card__icon principle-card__icon--teal" aria-hidden="true">
              ↗
            </div>
            <h3>图解</h3>
            <p>把分层、依赖与数据流画出来，让结构先于长篇定义出现。</p>
          </article>
          <article class="principle-card">
            <span class="principle-card__index">02</span>
            <div class="principle-card__icon principle-card__icon--blue" aria-hidden="true">
              ⌁
            </div>
            <h3>交互</h3>
            <p>通过点击、播放和模拟，观察同一份数据在不同阶段的变化。</p>
          </article>
          <article class="principle-card">
            <span class="principle-card__index">03</span>
            <div class="principle-card__icon principle-card__icon--amber" aria-hidden="true">
              ⌘
            </div>
            <h3>工程实践</h3>
            <p>不止讲定义，也解释真实生产环境为什么要做这样的取舍。</p>
          </article>
        </div>
      </section>

      <section class="course-map" id="course-map" aria-labelledby="course-map-title">
        <div class="course-map__intro">
          <span class="eyebrow">课程路线</span>
          <h2 id="course-map-title">
            从全局到实践，
            <br />
            沿着数据继续走。
          </h2>
          <p>先理解数据为什么需要流动，再逐步进入建模、调度、质量和治理。</p>
          <a class="text-link" href={`${baseUrl}learn/`}>
            进入学习空间 <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="course-map__list">
          {chapters.map((chapter) => {
            const lesson = chapter.lessons[0]
            return (
              <a
                class={`roadmap-row${lesson.demo !== 'coming-soon' ? ' is-ready' : ''}`}
                href={`${baseUrl}learn/${lesson.slug}/`}
              >
                <span class="roadmap-row__number">{chapter.id}</span>
                <span class="roadmap-row__title">
                  <strong>{chapter.title}</strong>
                  <small>{lesson.title}</small>
                </span>
                <span class="roadmap-row__status">
                  {lesson.demo !== 'coming-soon' ? '可学习' : '即将开放'}
                  <span aria-hidden="true">{lesson.demo !== 'coming-soon' ? '→' : '·'}</span>
                </span>
              </a>
            )
          })}
        </div>
      </section>

      <section class="closing-note" aria-label="项目理念">
        <span class="closing-note__mark" aria-hidden="true">
          “
        </span>
        <p>
          真正理解数据仓库，不是记住每个缩写，而是能回答：
          <strong>这份数据从哪里来，为什么要这样加工？</strong>
        </p>
      </section>
    </main>

    <footer class="site-footer">
      <div class="brand brand--footer">
        <span class="brand__mark" aria-hidden="true">
          <i />
          <i />
          <i />
        </span>
        <span class="brand__text">
          <strong>数据仓库图解</strong>
          <small>从一张表开始，看懂数据仓库。</small>
        </span>
      </div>
      <div class="site-footer__meta">
        <span>开源教材 · MVP</span>
        <span>License：待确定</span>
      </div>
    </footer>
  </div>
</BaseLayout>
