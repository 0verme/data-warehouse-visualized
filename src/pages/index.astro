---
import { HeroDataFlow } from '../components/visualizations/HeroDataFlow'
import BaseLayout from '../layouts/BaseLayout.astro'
import { chapters, lessons } from '../data/course'
import { getMessage } from '../i18n/messages'

const actualDemoCount = lessons.filter((lesson) => lesson.demo !== 'coming-soon').length
const baseUrl = import.meta.env.BASE_URL
---

<BaseLayout
  title="数据仓库图解｜从一张表开始，看懂数据仓库"
  description="面向中文学习者的交互式数据仓库可视化教材。看一行数据如何流过仓库，最后变成一个指标。"
>
  <div class="site-shell home-page">
    <header class="site-header">
      <a class="brand home-brand" href={baseUrl} aria-label="数据仓库图解首页">
        <span class="brand__mark" aria-hidden="true">
          <i />
          <i />
          <i />
        </span>
        <span class="brand__text">
          <strong>数据仓库图解</strong>
          <small>交互式教材</small>
        </span>
        <span class="home-brand__domain">
          <code>sql.sb</code>
        </span>
      </a>
      <nav class="site-header__nav" aria-label="主导航">
        <a href="#data-lesson">一行数据</a>
        <a href="#principles">学习方式</a>
        <a class="button button--nav" href={`${baseUrl}learn/`}>
          开始学习 <span aria-hidden="true">→</span>
        </a>
      </nav>
    </header>

    <main class="home-main">
      <section class="home-hero" aria-labelledby="hero-title">
        <div class="home-hero__copy">
          <div class="home-hero__kicker">
            <span class="home-hero__chapter">00 / INTRO</span>
            <span>第 0 节 · 数据从哪里开始</span>
          </div>
          <h1 id="hero-title">
            从一张表开始，
            <br class="home-hero__mobile-break" />
            <em>看懂</em>数据仓库。
          </h1>
          <p class="home-hero__lead">看一行数据如何流过仓库，最后变成一个指标。</p>
          <div class="home-hero__actions">
            <a class="button button--primary" href={`${baseUrl}learn/`}>
              进入课程 <span aria-hidden="true">→</span>
            </a>
            <a class="home-text-link" href="#data-lesson">
              继续看这行数据 <span aria-hidden="true">↓</span>
            </a>
          </div>
          <div class="home-hero__context">
            <span>一条订单的旅程</span>
            <code>source → transform → metric</code>
          </div>
        </div>

        <div class="home-hero__demo" aria-labelledby="hero-demo-title">
          <div class="home-hero__demo-heading">
            <span class="home-section-kicker">INTERACTIVE DATA FLOW</span>
            <h2 id="hero-demo-title">一行数据如何变成一个指标</h2>
          </div>
          <HeroDataFlow client:load />
        </div>
      </section>

      <section class="home-data-lesson" id="data-lesson" aria-labelledby="data-lesson-title">
        <div class="home-section-heading">
          <span class="home-section-kicker">01 / FOLLOW THE ROW</span>
          <h2 id="data-lesson-title">一行数据发生了什么？</h2>
          <p>同一笔订单经过不同层，每一层都只负责一件清楚的事。</p>
        </div>
        <ol class="home-data-lesson__list">
          <li class="home-data-lesson__row">
            <span class="home-data-lesson__node" aria-hidden="true" />
            <code class="home-data-lesson__step">01 / Source</code>
            <div>
              <strong>业务库 / orders</strong>
              <p>先保存正在发生的业务事实。</p>
            </div>
            <span class="home-data-lesson__value">
              <code>3 rows</code>
            </span>
          </li>
          <li class="home-data-lesson__row">
            <span class="home-data-lesson__node" aria-hidden="true" />
            <code class="home-data-lesson__step">02 / ODS</code>
            <div>
              <strong>原样接入 / ods_order</strong>
              <p>让来源数据有一个可回溯的落点。</p>
            </div>
            <span class="home-data-lesson__value">
              <code>3 rows</code>
            </span>
          </li>
          <li class="home-data-lesson__row home-data-lesson__row--filter">
            <span class="home-data-lesson__node" aria-hidden="true" />
            <code class="home-data-lesson__step">03 / DWD</code>
            <div>
              <strong>过滤与清洗 / dwd_order</strong>
              <p>
                <code>WHERE status = 'PAID'</code>，只留下有效订单。
              </p>
            </div>
            <span class="home-data-lesson__value">
              <code>2 valid rows</code>
            </span>
          </li>
          <li class="home-data-lesson__row home-data-lesson__row--metric">
            <span class="home-data-lesson__node" aria-hidden="true" />
            <code class="home-data-lesson__step">04 / Metric</code>
            <div>
              <strong>指标 / GMV</strong>
              <p>
                <code>SUM(amount)</code> 把明细聚合成可使用的数字。
              </p>
            </div>
            <span class="home-data-lesson__value">
              <code>¥598</code>
            </span>
          </li>
        </ol>
      </section>

      <section class="home-principles" id="principles" aria-labelledby="principles-title">
        <div class="home-section-heading home-section-heading--wide">
          <span class="home-section-kicker">02 / METHOD</span>
          <h2 id="principles-title">学习不是读完，而是让结果发生。</h2>
          <p>把抽象的概念放进数据流里，看见结构、动作和工程取舍。</p>
        </div>
        <div class="home-principles__list">
          <article class="home-principle-row">
            <span class="home-principle-row__index">01</span>
            <h3>看结构</h3>
            <p>把抽象的数据流、依赖关系和分层画出来，让结构先于长篇定义出现。</p>
            <code>table / node / flow</code>
          </article>
          <article class="home-principle-row">
            <span class="home-principle-row__index">02</span>
            <h3>动手改</h3>
            <p>点击、播放、修改参数，看同一份数据在不同阶段如何变化。</p>
            <code>click / play / inspect</code>
          </article>
          <article class="home-principle-row">
            <span class="home-principle-row__index">03</span>
            <h3>看工程现实</h3>
            <p>不仅告诉你“是什么”，还解释生产系统为什么这样设计、如何承担变化。</p>
            <code>trade-off / boundary</code>
          </article>
        </div>
      </section>

      <section class="home-course-map" id="course-map" aria-labelledby="course-map-title">
        <div class="home-course-map__intro">
          <span class="home-section-kicker">03 / COURSE MAP</span>
          <h2 id="course-map-title">沿着数据继续走。</h2>
          <p>从全局视角开始，逐步进入分层、建模、指标与工程实践。</p>
          <div class="home-course-map__meta" aria-label="课程概览">
            <span>
              <code>{lessons.length}</code> 节路线
            </span>
            <span>
              <code>{actualDemoCount}</code> 个交互实验
            </span>
            <span>无需登录</span>
          </div>
          <a class="home-text-link" href={`${baseUrl}learn/`}>
            进入学习空间 <span aria-hidden="true">→</span>
          </a>
        </div>
        <ol class="home-course-map__list">
          {chapters.map((chapter) => {
            const lesson =
              chapter.lessons.find((chapterLesson) => chapterLesson.demo !== 'coming-soon') ??
              chapter.lessons[0]
            const isReady = lesson.demo !== 'coming-soon'
            return (
              <li>
                <a
                  class={`home-course-row${isReady ? ' is-ready' : ''}`}
                  href={`${baseUrl}learn/${lesson.slug}/`}
                >
                  <code class="home-course-row__number">{chapter.id}</code>
                  <span class="home-course-row__title">
                    <strong>{chapter.title}</strong>
                    <small>{lesson.title}</small>
                  </span>
                  <span class="home-course-row__status">
                    {isReady ? getMessage('availableLesson') : getMessage('comingSoon')}
                    <span aria-hidden="true">{isReady ? '→' : '·'}</span>
                  </span>
                </a>
              </li>
            )
          })}
        </ol>
      </section>

      <section class="home-closing-note" aria-label="项目理念">
        <span class="home-closing-note__mark" aria-hidden="true">
          →
        </span>
        <p>
          真正理解数据仓库，不是记住每个缩写，而是能回答：
          <strong>这份数据从哪里来，为什么要这样加工？</strong>
        </p>
      </section>
    </main>

    <footer class="site-footer home-footer">
      <div class="brand brand--footer home-brand">
        <span class="brand__mark" aria-hidden="true">
          <i />
          <i />
          <i />
        </span>
        <span class="brand__text">
          <strong>数据仓库图解</strong>
          <small>从一张表开始，看懂数据仓库。</small>
        </span>
      </div>
      <div class="site-footer__meta">
        <span>
          <code>sql.sb</code>
        </span>
        <a href="https://x.com/0verme8" target="_blank" rel="noopener noreferrer">
          X / @0verme8
        </a>
      </div>
    </footer>
  </div>
</BaseLayout>
