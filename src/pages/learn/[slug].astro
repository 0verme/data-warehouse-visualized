---
import { LearnShell } from '../../components/course/LearnShell'
import { getLessonContent } from '../../content/lessons'
import type { LessonContent } from '../../content/types'
import { lessons, type Lesson } from '../../data/course'
import { buildLessonCodeHighlightMap } from '../../utils/build-code-highlight'
import type { CodeHighlightMap } from '../../utils/code-highlight'
import { getLessonStyleUrls, learnSharedStyleUrls } from '../../utils/lesson-styles'
import BaseLayout from '../../layouts/BaseLayout.astro'

interface Props {
  lesson: Lesson
  content: LessonContent
  codeHighlights: CodeHighlightMap
}

export async function getStaticPaths() {
  const codeHighlights = await buildLessonCodeHighlightMap(lessons)

  return lessons.map((lesson) => ({
    params: { slug: lesson.slug },
    props: {
      lesson,
      content: getLessonContent(lesson),
      codeHighlights,
    },
  }))
}

const { lesson, content, codeHighlights } = Astro.props
const pageTitle = `${lesson.title}｜数据仓库图解`
const styleUrls = [...learnSharedStyleUrls, ...getLessonStyleUrls(content)]
---

<BaseLayout
  title={pageTitle}
  description={lesson.summary}
  styleUrls={styleUrls}
  pageClass="learn-page"
>
  <LearnShell
    client:load
    transition:persist="learn-shell"
    lessons={lessons}
    initialLesson={lesson}
    initialContent={content}
    codeHighlights={codeHighlights}
  />
</BaseLayout>
