---
import EnglishFoundationShell from '../../../components/EnglishFoundationShell.astro'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import englishFoundationStylesUrl from '../../../styles/layouts/english-foundation.css?url'
import { getEnglishRoute } from '../../../utils/english-routes'

const title = 'SQL Resources | English Data Engineering | sql.sb'
const description =
  'Practical English SQL pages about query behavior, unexpected results and debugging. Start with why a JOIN duplicates rows, inflated SUM and COUNT, and the fixes that keep the original grain.'
---

<BaseLayout
  title={title}
  description={description}
  lang="en"
  ogLocale="en_US"
  styleUrls={[englishFoundationStylesUrl]}
>
  <EnglishFoundationShell active="sql">
    <main class="english-foundation__main">
      <p class="english-foundation__eyebrow">English namespace · SQL</p>
      <h1 class="english-foundation__title">SQL resources</h1>
      <p class="english-foundation__lede">
        English pages about SQL behavior, query results and debugging. Each page starts from a real
        query problem and shows the observable rows behind it.
      </p>
      <nav class="english-foundation__cards" aria-label="English SQL pages">
        <a class="english-foundation__card" href={getEnglishRoute('joinDuplicateRows')}>
          <strong>Why does a SQL JOIN duplicate rows?</strong>
          <span>
            Row multiplication from 1:N and M:N keys, inflated SUM and COUNT, why DISTINCT hides the
            symptom, and the fixes that keep the order grain intact.
          </span>
        </a>
      </nav>
      <nav class="english-foundation__related" aria-label="Related English namespaces">
        <a href={getEnglishRoute('overview')}>English resources overview</a>
        <a href={getEnglishRoute('warehouse')}>Data warehouse pages</a>
        <a href={getEnglishRoute('tools')}>Explore tools</a>
      </nav>
    </main>
  </EnglishFoundationShell>
</BaseLayout>
