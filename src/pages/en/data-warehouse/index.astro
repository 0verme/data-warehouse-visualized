---
import EnglishFoundationShell from '../../../components/EnglishFoundationShell.astro'
import BaseLayout from '../../../layouts/BaseLayout.astro'
import englishFoundationStylesUrl from '../../../styles/layouts/english-foundation.css?url'
import { getEnglishRoute } from '../../../utils/english-routes'

const title = 'Data Warehouse Engineering | English Resources | sql.sb'
const description =
  'What a data warehouse is for, plus English pages on grain, idempotent ETL, data lineage versus task dependency, and SCD Type 2 history.'
---

<BaseLayout
  title={title}
  description={description}
  lang="en"
  ogLocale="en_US"
  styleUrls={[englishFoundationStylesUrl]}
>
  <EnglishFoundationShell active="warehouse">
    <main class="english-foundation__main">
      <p class="english-foundation__eyebrow">English namespace · Data warehouse</p>
      <h1 class="english-foundation__title">Data warehouse engineering</h1>
      <p class="english-foundation__lede">
        Modeling, pipeline semantics and data reliability. Each page starts from a concrete failure
        or decision and shows the rows and state transitions behind it — not just definitions.
      </p>
      <section class="english-foundation__definition" aria-labelledby="what-is-a-data-warehouse">
        <h2 id="what-is-a-data-warehouse" class="english-foundation__definition-title">
          What is a data warehouse?
        </h2>
        <p>
          A data warehouse is a database built for analysis rather than transaction processing. It
          consolidates data from operational systems, models it into tables that answer business
          questions, and keeps one trusted version of that data for reporting and analytics —
          instead of every team querying each source system on its own.
        </p>
        <p>
          Most warehouse work is therefore about decisions, not storage: what one row represents,
          how a metric is defined, how data arrives and changes over time, and how failures are
          detected and repaired. Each page below works through one of those problems with concrete
          rows and state.
        </p>
      </section>
      <nav class="english-foundation__cards" aria-label="English data warehouse pages">
        <a class="english-foundation__card" href={getEnglishRoute('grain')}>
          <strong>Data warehouse grain</strong>
          <span>
            What does one row represent? Why grain comes first, and how a wrong grain inflates a
            measure after a join.
          </span>
        </a>
        <a class="english-foundation__card" href={getEnglishRoute('idempotentEtl')}>
          <strong>Idempotent ETL</strong>
          <span>
            Run the same input twice and compare append, overwrite and merge-upsert: duplicate rows,
            retries and backfills.
          </span>
        </a>
        <a class="english-foundation__card" href={getEnglishRoute('lineageVsTaskDependency')}>
          <strong>Data lineage vs task dependency</strong>
          <span>
            One workflow, two graphs: why scheduler dependencies and SQL lineage disagree, and what
            that does to impact analysis.
          </span>
        </a>
        <a class="english-foundation__card" href={getEnglishRoute('scdType2')}>
          <strong>SCD Type 2</strong>
          <span>
            {'Effective dates, historical rows, the current flag and the boundary semantics of '}
            <code>[effective_from, effective_to)</code>.
          </span>
        </a>
        <a class="english-foundation__card" href={getEnglishRoute('pipelineFailureRecovery')}>
          <strong>Pipeline failure recovery</strong>
          <span>
            Bad rows are already downstream. Find the impact closure, stop running work, replay in
            dependency order and re-notify consumers.
          </span>
        </a>
        <a class="english-foundation__card" href={getEnglishRoute('dataQualityChecks')}>
          <strong>Data quality checks</strong>
          <span>
            Eight checks across identity, fields, references, completeness, freshness and
            reconciliation — and when a failed check should block the release.
          </span>
        </a>
        <a class="english-foundation__card" href={getEnglishRoute('dataContracts')}>
          <strong>Data contracts</strong>
          <span>
            What producers and consumers agree on, and which interface changes break consumers
            loudly or silently.
          </span>
        </a>
        <a class="english-foundation__card" href={getEnglishRoute('pipelineObservability')}>
          <strong>Pipeline observability</strong>
          <span>
            The signals that show whether a pipeline is healthy over time — and why a green run can
            still hide stale or incomplete data.
          </span>
        </a>
        <a class="english-foundation__card" href={getEnglishRoute('factVsDimensionTables')}>
          <strong>Fact vs dimension tables</strong>
          <span>
            Which table stores the measure, which one stores the attributes, and how a duplicated
            dimension key inflates the total.
          </span>
        </a>
        <a class="english-foundation__card" href={getEnglishRoute('factVsDimensionTables')}>
          <strong>Fact vs dimension tables</strong>
          <span>
            Which table stores the measure, which one stores the attributes, and how a duplicated
            dimension key inflates the total.
          </span>
        </a>
      </nav>
      <nav class="english-foundation__related" aria-label="Related English namespaces">
        <a href={getEnglishRoute('overview')}>English resources overview</a>
        <a href={getEnglishRoute('sql')}>SQL pages</a>
        <a href={getEnglishRoute('tools')}>Explore tools</a>
      </nav>
    </main>
  </EnglishFoundationShell>
</BaseLayout>
