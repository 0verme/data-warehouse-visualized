---
import { ClientRouter } from 'astro:transitions'
import globalStylesUrl from '../styles/global.css?url'

interface Props {
  title: string
  description: string
  canonical?: string | null
  lang?: 'zh-CN' | 'en'
  ogLocale?: 'zh_CN' | 'en_US'
  /** Page-owned stylesheets (home, learn shell, lesson/visualization styles). */
  styleUrls?: string[]
  /** Optional page-state class on the root element, e.g. `learn-page`. */
  pageClass?: string
}

const {
  title,
  description,
  canonical,
  lang = 'zh-CN',
  ogLocale = 'zh_CN',
  styleUrls = [],
  pageClass,
} = Astro.props
const stylesheetUrls = [globalStylesUrl, ...styleUrls]
const baseUrl = import.meta.env.BASE_URL
const basePath = baseUrl.replace(/\/+$/, '')
const pathname = Astro.url.pathname || '/'
const canonicalPath =
  basePath && (pathname === basePath || pathname.startsWith(`${basePath}/`))
    ? pathname.slice(basePath.length) || '/'
    : pathname
const siteUrl = import.meta.env.PUBLIC_SITE_URL?.replace(/\/+$/, '') || Astro.site?.origin
const canonicalUrl =
  canonical === null
    ? null
    : (canonical ?? (siteUrl ? new URL(canonicalPath, `${siteUrl}/`).href : canonicalPath))
---

<!doctype html>
<html lang={lang} data-theme="light" class={pageClass}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f7fb" />
    <slot name="head" />
    <script is:inline>
      ;(() => {
        const themeStorageKey = 'data-warehouse-visualized:theme'

        function restorePreferences() {
          let theme = 'light'

          try {
            theme = localStorage.getItem(themeStorageKey) === 'dark' ? 'dark' : 'light'
          } catch {
            // localStorage 受限时保留默认主题。
          }

          document.documentElement.dataset.theme = theme
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', theme === 'dark' ? '#0d1726' : '#f5f7fb')
        }

        restorePreferences()
        document.addEventListener('astro:after-swap', restorePreferences)
      })()
    </script>
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    {canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    {stylesheetUrls.map((href) => (
      <link rel="stylesheet" href={href} />
    ))}
    <ClientRouter fallback="none" />
  </head>
  <body>
    <slot />
  </body>
</html>
