---
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  canonical?: string
}

const { title, description, canonical } = Astro.props
const baseUrl = import.meta.env.BASE_URL
const canonicalPath = Astro.url.pathname.startsWith(baseUrl)
  ? Astro.url.pathname
  : `${baseUrl}${Astro.url.pathname.replace(/^\//, '')}`
const siteUrl = import.meta.env.PUBLIC_SITE_URL?.replace(/\/+$/, '') || Astro.site?.origin
const canonicalUrl =
  canonical ?? (siteUrl ? new URL(canonicalPath, `${siteUrl}/`).href : canonicalPath)
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f7fb" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <ClientRouter fallback="none" />
  </head>
  <body>
    <slot />
  </body>
</html>
